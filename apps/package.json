{
  "name": "@movie-ticket/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:gateway && npm run build:identity",
    "build:gateway": "nest build api-gateway",
    "build:identity": "nest build identity-service",
    "format": "prettier --write \"{api-gateway,identity-service,libs,test}/**/*.{ts,json}\" \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check \"{api-gateway,identity-service,libs,test}/**/*.{ts,json}\" \"*.{json,mjs,ts}\"",
    "lint": "eslint \"{api-gateway,identity-service,libs,test}/**/*.ts\"",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.ts --runInBand --passWithNoTests",
    "test:integration": "jest --config jest.config.ts --runInBand --testMatch \"<rootDir>/**/test/integration/**/*.spec.ts\"",
    "test:migration": "jest --config jest.config.ts --runInBand --testMatch \"<rootDir>/identity-service/test/integration/migration-seed.spec.ts\"",
    "test:concurrency": "jest --config jest.config.ts --runInBand --testMatch \"<rootDir>/identity-service/test/integration/refresh-concurrency.spec.ts\"",
    "test:e2e": "jest --config jest.config.ts --runInBand --testMatch \"<rootDir>/**/test/e2e/**/*.e2e-spec.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/typeorm": "^11.0.3",
    "@noble/hashes": "^2.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "hash-wasm": "^4.12.0",
    "pg": "^8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.9",
    "@types/pg": "^8.20.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "engines": {
    "node": ">=20.11"
  },
  "overrides": {
    "find-my-way": "9.7.0"
  }
}
