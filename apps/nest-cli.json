{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "api-gateway",
  "sourceRoot": "api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "api-gateway",
      "entryFile": "main",
      "sourceRoot": "api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "api-gateway/tsconfig.app.json"
      }
    },
    "identity-service": {
      "type": "application",
      "root": "identity-service",
      "entryFile": "main",
      "sourceRoot": "identity-service/src",
      "compilerOptions": {
        "tsConfigPath": "identity-service/tsconfig.app.json"
      }
    }
  }
}
