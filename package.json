{
  "name": "movie-ticket-booking-repository-tooling",
  "private": true,
  "scripts": {
    "sync:frontend-control": "node tools/frontend-control-plane/sync-frontend-control-plane.mjs",
    "check:frontend-roadmap": "node tools/frontend-control-plane/validate-frontend-roadmap.mjs && node tools/frontend-control-plane/validate-frontend-roadmap.mjs --self-test",
    "check:frontend-control": "node tools/frontend-control-plane/sync-frontend-control-plane.mjs --check && node tools/frontend-control-plane/validate-frontend-control-plane.mjs",
    "build:dashboard": "node tools/control-plane/build-master-dashboard.mjs",
    "check:dashboard": "node tools/control-plane/build-master-dashboard.mjs --check && node tools/control-plane/validate-master-dashboard.mjs && node tools/control-plane/validate-master-dashboard.mjs --self-test",
    "status:work": "node tools/frontend-control-plane/status-work.mjs",
    "check:mermaid": "node tools/repository/validate-mermaid.mjs",
    "check:mermaid:self-test": "node tools/repository/validate-mermaid.mjs --self-test",
    "fix:mermaid": "node tools/repository/validate-mermaid.mjs --fix",
    "check:docs": "npm run fix:mermaid && node tools/control-plane/sync-control-plane.mjs && node tools/frontend-control-plane/sync-frontend-control-plane.mjs && node tools/repository/validate-repository.mjs",
    "check:repository": "node tools/repository/validate-repository.mjs"
  },
  "devDependencies": {
    "jsdom": "24.1.3",
    "mermaid": "10.9.6"
  }
}
