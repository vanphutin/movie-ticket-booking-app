{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket.schema.json",
  "title": "Executable project ticket",
  "type": "object",
  "required": [
    "ticket_id",
    "title",
    "actor",
    "business_outcome",
    "prerequisites",
    "contract_ids",
    "scope",
    "out_of_scope",
    "invariants",
    "failure_cases",
    "security_cases",
    "acceptance_criteria",
    "required_artifacts",
    "expected_files",
    "completion_condition"
  ],
  "properties": {
    "ticket_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "business_outcome": { "type": "string", "minLength": 1 },
    "prerequisites": { "type": "array" },
    "contract_ids": { "type": "array", "minItems": 1 },
    "scope": { "type": "array", "minItems": 1 },
    "out_of_scope": { "type": "array" },
    "invariants": { "type": "array", "minItems": 1 },
    "failure_cases": { "type": "array" },
    "security_cases": { "type": "array" },
    "acceptance_criteria": { "type": "array", "minItems": 1 },
    "required_artifacts": { "type": "array", "minItems": 1 },
    "expected_files": { "type": "array" },
    "completion_condition": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
