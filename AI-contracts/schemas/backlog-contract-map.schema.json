{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backlog-contract-map.schema.json",
  "title": "Backlog to API contract registry",
  "type": "object",
  "required": ["schema_version", "source_backlog", "endpoint_count", "endpoints"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_backlog": { "type": "string" },
    "endpoint_count": { "const": 55 },
    "endpoints": {
      "type": "array",
      "minItems": 55,
      "maxItems": 55,
      "items": {
        "type": "object",
        "required": [
          "endpoint_id",
          "backlog_ids",
          "method",
          "path",
          "owner",
          "priority",
          "disposition",
          "auth",
          "idempotency",
          "capability_ids",
          "ticket_ids"
        ]
      }
    }
  },
  "additionalProperties": true
}
