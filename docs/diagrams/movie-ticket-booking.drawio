        </mxCell>
        <mxCell id="h-note" value="Bản production HA: nhân đôi hạ tầng qua 2 Availability Zone trong cùng Region — mục tiêu chịu được sự cố trọn một AZ. Cùng lưu ý phạm vi như trang 7: thiết kế tham khảo hậu-MVP, không thuộc release gate tuần 10 của contract." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1720" height="50" as="geometry" />
