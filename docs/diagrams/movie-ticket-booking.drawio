          <mxGeometry x="40" y="15" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g-note" value="Lưu ý phạm vi: product backlog ghi Kubernetes/cloud deployment là OUT-OF-SCOPE cho MVP (Docker Compose local đủ cho portfolio). Trang này là phương án triển khai AWS hậu-MVP để tham khảo. Broker trong contract chưa chốt — Amazon MQ / MSK / SQS-SNS là các lựa chọn." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
