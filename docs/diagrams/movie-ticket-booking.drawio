  <diagram id="page-roadmap" name="6. Roadmap tuần 4–10">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f-title" value="Roadmap 8 phase — 35 daily ticket, tuần 4–10 (AI-contracts/roadmap/)" style="text;html=1;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f-p0" value="&lt;b&gt;P0 — Contract và Foundation Gate&lt;/b&gt;&lt;br&gt;(W4/D1)&lt;hr&gt;Freeze baseline, chứng minh foundation; FG-001 phải VERIFIED trước khi code. ← ĐANG Ở ĐÂY (BLOCKED)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="195" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f-p1" value="&lt;b&gt;P1 — Identity, Gateway, AuthN/Z&lt;/b&gt;&lt;br&gt;(W4)&lt;hr&gt;Customer authenticate an toàn; boundary admin/customer được enforce." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="255" y="80" width="195" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f-p2" value="&lt;b&gt;P2 — Catalog và Scheduling&lt;/b&gt;&lt;br&gt;(W5–6)&lt;hr&gt;Guest tìm được nội dung published; Admin quản lý lịch chiếu hợp lệ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="195" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f-p3" value="&lt;b&gt;P3 — Reliable Event Contract&lt;/b&gt;&lt;br&gt;(W6)&lt;hr&gt;Booking nhận showtime facts tin cậy; replay fixture verified." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="685" y="80" width="195" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f-p4" value="&lt;b&gt;P4 — Booking và Concurrency&lt;/b&gt;&lt;br&gt;(W7)&lt;hr&gt;Customer giữ ghế không oversell; race/replay verified — exactly one winner." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="195" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f-p5" value="&lt;b&gt;P5 — Payment, Ticket và Worker&lt;/b&gt;&lt;br&gt;(W8)&lt;hr&gt;Customer thanh toán và nhận đúng một vé; webhook verify, retry/DLQ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1115" y="80" width="195" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f-p6" value="&lt;b&gt;P6 — Observability và Operations&lt;/b&gt;&lt;br&gt;(W9)&lt;hr&gt;Operator chẩn đoán, degrade và phục hồi hệ thống; runbook." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1330" y="80" width="195" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f-p7" value="&lt;b&gt;P7 — Release và Handover&lt;/b&gt;&lt;br&gt;(W10)&lt;hr&gt;Reviewer reproduce được; learner defend hệ thống; feature freeze, không domain mới." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1545" y="80" width="195" height="160" as="geometry" />
        </mxCell>
        <mxCell id="f-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="f-p0" target="f-p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="f-p1" target="f-p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="f-p2" target="f-p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="f-p3" target="f-p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-a5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="f-p4" target="f-p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-a6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="f-p5" target="f-p6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-a7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="f-p6" target="f-p7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-ms" value="&lt;b&gt;Milestones:&lt;/b&gt;&lt;br&gt;M0 Contract baseline (P0): effective contract map, ticket graph, FG-001 VERIFIED&lt;br&gt;M1 Trusted identity edge (P1): auth/profile qua Gateway; deny/replay/trace evidence&lt;br&gt;M2 Movie catalog (P2): movie/trailer migration, API, query evidence&lt;br&gt;M3 Scheduling và publication (P2/P3): showtime hợp lệ + atomic versioned event&lt;br&gt;M4 Safe booking (P4): snapshot/hold/confirm — exactly one winner&lt;br&gt;M5 Reliable payment/ticket (P5): verified webhook, một ticket, retry/DLQ&lt;br&gt;M6 Operable system (P6): traces, bounded failure, restore/runbook&lt;br&gt;M7 Release evidence (P7): clean release, traceability, demo/interview" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="830" height="220" as="geometry" />
        </mxCell>
        <mxCell id="f-gates" value="&lt;b&gt;Cơ chế gate:&lt;/b&gt;&lt;br&gt;• Mỗi tuần có weekly gate; ticket chỉ mở khi mọi prerequisite VERIFIED (không suy đoán từ checkbox/DONE).&lt;br&gt;• Learning-first: mỗi ticket phải qua learning gate (teach → hỏi 3–5 câu → PASSED) trước design/code.&lt;br&gt;• Sau mỗi vertical-slice D05: post-MVP optimization gate (baseline → review → NOT_REQUIRED / OPTIMIZATION_REQUIRED / DEFERRED_WITH_BUDGET); BLOCKER/HIGH khóa dependency.&lt;br&gt;• Trạng thái review: BLOCKED / CHANGES_REQUIRED / CONDITIONAL_PASS / VERIFIED; DONE không đồng nghĩa VERIFIED.&lt;br&gt;• Tuần theo tuần: W4 contract + Identity/Security → W5 Catalog → W6 scheduling/events → W7 Booking/concurrency → W8 payment/ticket/worker → W9 operations → W10 release." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="290" width="840" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-aws-1az" name="7. AWS — 1 AZ (dev/staging)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
