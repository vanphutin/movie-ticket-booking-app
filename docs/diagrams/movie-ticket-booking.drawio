<mxfile host="app.diagrams.net" agent="claude" pages="8">
  <diagram id="page-overview" name="1. Tổng quan và Actors">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a-title" value="Movie Ticket Booking — Microservices Backend (thiết kế theo contract, tuần 4–10)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-status" value="Trạng thái 28/07/2026: PC-2026.3 hiệu lực; CCR-005 đã map 55/55 endpoint; repository chưa scaffold source code; Foundation Gate FG-001 chưa VERIFIED. Staff là POST_MVP, AI là STRETCH. Toàn bộ diagram là THIẾT KẾ DỰ KIẾN, không phải hệ thống đã chạy." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1460" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a-h-actors" value="Actors" style="text;html=1;align=left;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a-act1" value="&lt;b&gt;Guest&lt;/b&gt;&lt;hr&gt;Xem catalog/suất chiếu đã publish; đăng ký, đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="175" width="225" height="95" as="geometry" />
        </mxCell>
        <mxCell id="a-act2" value="&lt;b&gt;Customer&lt;/b&gt;&lt;hr&gt;Quản lý profile/session; giữ ghế, booking, thanh toán; xem vé của mình" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="285" y="175" width="225" height="95" as="geometry" />
        </mxCell>
        <mxCell id="a-act3" value="&lt;b&gt;Staff — POST_MVP&lt;/b&gt;&lt;hr&gt;Tra cứu vé bằng ticket code; check-in vé; chưa được authorize trong MVP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="175" width="225" height="95" as="geometry" />
        </mxCell>
        <mxCell id="a-act4" value="&lt;b&gt;Admin&lt;/b&gt;&lt;hr&gt;Quản lý movie, cinema, screen, seat, showtime; không đọc credential/payment secret" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="775" y="175" width="225" height="95" as="geometry" />
        </mxCell>
        <mxCell id="a-act5" value="&lt;b&gt;Service identity&lt;/b&gt;&lt;hr&gt;Gọi internal boundary tối thiểu, được authenticate và audit" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="175" width="225" height="95" as="geometry" />
        </mxCell>
        <mxCell id="a-act6" value="&lt;b&gt;Operator&lt;/b&gt;&lt;hr&gt;Quan sát health/metrics/DLQ/reconciliation; không sửa business state trực tiếp" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1265" y="175" width="235" height="95" as="geometry" />
        </mxCell>
        <mxCell id="a-h-mvp" value="MVP Scope (10 nhóm tính năng)" style="text;html=1;align=left;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a-mvp1" value="&lt;b&gt;Public Catalog&lt;/b&gt;&lt;hr&gt;Danh sách/chi tiết phim, trailer published, rạp, suất chiếu theo phim/rạp/ngày, seat map (AVAILABLE/HELD/SOLD)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="278" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-mvp2" value="&lt;b&gt;Auth và RBAC&lt;/b&gt;&lt;hr&gt;Register/login (email + password, bcrypt), JWT access + refresh token rotation, logout revoke, RBAC Guest/Customer/Staff/Admin" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="336" y="325" width="278" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-mvp3" value="&lt;b&gt;Seat Hold và Booking&lt;/b&gt;&lt;hr&gt;Giữ nhiều ghế/suất chiếu; SELECT … FOR UPDATE chống double-booking; hold hết hạn 5 phút; booking hết hạn 15 phút; hủy khi PENDING" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="632" y="325" width="278" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-mvp4" value="&lt;b&gt;Payment (payOS)&lt;/b&gt;&lt;hr&gt;Tạo payment link; webhook verify chữ ký; idempotent; đối soát amount/orderCode/paymentLinkId; PAID → booking CONFIRMED + ghế SOLD + tạo ticket" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="928" y="325" width="278" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-mvp5" value="&lt;b&gt;Ticket issuance (MVP)&lt;/b&gt;&lt;hr&gt;Ticket tự động khi CONFIRMED; customer xem vé. Staff lookup/check-in là POST_MVP, không chặn MVP release." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1224" y="325" width="276" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-mvp6" value="&lt;b&gt;Admin Management&lt;/b&gt;&lt;hr&gt;CRUD phim/trailer/rạp/phòng/ghế; tạo suất chiếu (snapshot seat map); publish/hủy suất chiếu; xem bookings/payments; sync payment thủ công" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="455" width="278" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-mvp7" value="&lt;b&gt;Background Jobs&lt;/b&gt;&lt;hr&gt;BullMQ: expire seat hold (5 phút), expire pending booking (15 phút); retry strategy + error logging cho mọi job" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="336" y="455" width="278" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-mvp8" value="&lt;b&gt;Logging và Operations&lt;/b&gt;&lt;hr&gt;Audit log (ai/làm gì/lúc nào), integration log (payOS, AI), error envelope thống nhất, request-id tracking xuyên suốt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="632" y="455" width="278" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-mvp9" value="&lt;b&gt;Infrastructure&lt;/b&gt;&lt;hr&gt;Docker Compose (Gateway, 3 service, Worker, PostgreSQL tách theo service, Redis); GitHub Actions CI; Swagger/OpenAPI; migrations (cấm synchronize:true); seed demo" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="928" y="455" width="278" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-mvp10" value="&lt;b&gt;AI (stretch)&lt;/b&gt;&lt;hr&gt;NLP movie search (pgvector embeddings), AI content draft cho admin (human-in-the-loop), recommendations + feedback — không thuộc release gate nếu core chưa xong" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1224" y="455" width="276" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-h-oos" value="Out of scope" style="text;html=1;align=left;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a-oos" value="Frontend/mobile UI • email/SMS notification • nhiều payment gateway (chỉ payOS) • social login • avatar upload • i18n • WebSocket seat map realtime (dùng polling) • coupon/promotion/loyalty • refund automation • real payment settlement • semantic search/recommendation ngoài stretch • multi-region • Kubernetes/cloud (chỉ Docker Compose local) • WAF/rate-limit nâng cao • admin UI (chỉ API + Swagger) • reporting/analytics • seat pricing tiers • multi-chain rạp • không domain mới trong tuần 10 (feature freeze)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="625" width="1460" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a-src" value="Nguồn: AI-contracts/contracts/ (product, architecture, api, event), AI-contracts/decisions/ADR-001, docs/database/01–12, docs/product-backlog/, AI-contracts/roadmap/. Các trang tiếp theo: 2-Kiến trúc • 3-ERD • 4-Luồng Booking/Payment • 5-State machines • 6-Roadmap • 7-AWS 1 AZ • 8-AWS Multi-AZ." style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1460" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-architecture" name="2. Kiến trúc hệ thống">
    <mxGraphModel dx="2355" dy="1183" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b-title" parent="1" style="text;html=1;align=left;fontSize=18;fontStyle=1;" value="Kiến trúc Microservices (ARCH-001…026, ADR-001 — topology dự kiến)" vertex="1">
          <mxGeometry height="30" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="b-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Broker cụ thể chưa được chọn trong contract; mỗi service theo clean architecture: transport/adapters → application → domain (ARCH-006/017/018). Mọi trust boundary (client→Gateway, Gateway→service, broker→consumer, provider→webhook, operator→ops) đều authenticate/validate/authorize (ARCH-008)." vertex="1">
          <mxGeometry height="50" width="1460" x="40" y="55" as="geometry" />
        </mxCell>
        <mxCell id="b-guest" parent="1" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;" value="Guest / Customer" vertex="1">
          <mxGeometry height="70" width="50" x="220" y="125" as="geometry" />
        </mxCell>
        <mxCell id="b-admin" parent="1" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;" value="Admin" vertex="1">
          <mxGeometry height="70" width="50" x="450" y="125" as="geometry" />
        </mxCell>
        <mxCell id="b-staff" parent="1" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;" value="Staff" vertex="1">
          <mxGeometry height="70" width="50" x="680" y="125" as="geometry" />
        </mxCell>
        <mxCell id="b-operator" parent="1" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;" value="Operator" vertex="1">
          <mxGeometry height="70" width="50" x="1370" y="125" as="geometry" />
        </mxCell>
        <mxCell id="b-gateway" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;API Gateway (ARCH-001)&lt;/b&gt; — điểm vào duy nhất /api/v1&lt;br&gt;Routing • edge validation • Bearer auth context propagation • correlation-id • rate limit • error envelope chuẩn (code/message/requestId).&lt;br&gt;&lt;b&gt;KHÔNG&lt;/b&gt; business logic, &lt;b&gt;KHÔNG&lt;/b&gt; database (ARCH-013)." vertex="1">
          <mxGeometry height="100" width="760" x="160" y="280" as="geometry" />
        </mxCell>
        <mxCell id="b-payos" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;" value="&lt;b&gt;payOS (external provider)&lt;/b&gt;&lt;br&gt;Checkout page, payment link, webhook có chữ ký" vertex="1">
          <mxGeometry height="90" width="220" x="1300" y="255" as="geometry" />
        </mxCell>
        <mxCell id="b-identity" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="&lt;b&gt;Identity Service (ARCH-002)&lt;/b&gt;&lt;hr&gt;users, roles (CUSTOMER/STAFF/ADMIN), refresh sessions — token lifecycle: rotation + reuse detection; bcrypt password hash.&lt;br&gt;&lt;br&gt;Không sở hữu: catalog/booking/payment state." vertex="1">
          <mxGeometry height="180" width="280" x="100" y="460" as="geometry" />
        </mxCell>
        <mxCell id="b-catalog" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="&lt;b&gt;Catalog Service (ARCH-003)&lt;/b&gt;&lt;hr&gt;movie, trailer, cinema, screen, seat definition, showtime lifecycle/publication; AI content draft + embeddings (stretch).&lt;br&gt;&lt;br&gt;Không sở hữu: hold/booking/payment." vertex="1">
          <mxGeometry height="180" width="300" x="430" y="460" as="geometry" />
        </mxCell>
        <mxCell id="b-booking" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;Booking Service (ARCH-004)&lt;/b&gt;&lt;hr&gt;showtime snapshot, seat availability (showtime_seats), seat hold, booking, payment và ticket workflow; inbox/outbox.&lt;br&gt;&lt;br&gt;Không sở hữu: credential/catalog truth." vertex="1">
          <mxGeometry height="180" width="330" x="780" y="460" as="geometry" />
        </mxCell>
        <mxCell id="b-worker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Worker (ARCH-005)&lt;/b&gt;&lt;hr&gt;Outbox relay, hold/booking expiry, retry + backoff/jitter, DLQ.&lt;br&gt;&lt;br&gt;Chỉ thao tác qua contract/port — KHÔNG truy cập trực tiếp database nghiệp vụ (ARCH-013)." vertex="1">
          <mxGeometry height="180" width="290" x="1230" y="460" as="geometry" />
        </mxCell>
        <mxCell id="b-iddb" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="identity_db&lt;br&gt;(PostgreSQL)" vertex="1">
          <mxGeometry height="100" width="180" x="150" y="710" as="geometry" />
        </mxCell>
        <mxCell id="b-catdb" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="catalog_db&lt;br&gt;(PostgreSQL + pgvector)" vertex="1">
          <mxGeometry height="100" width="200" x="480" y="710" as="geometry" />
        </mxCell>
        <mxCell id="b-bkgdb" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="booking_db&lt;br&gt;(PostgreSQL — ACID, FOR UPDATE)" vertex="1">
          <mxGeometry height="100" width="200" x="845" y="710" as="geometry" />
        </mxCell>
        <mxCell id="b-redis" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Redis / BullMQ&lt;br&gt;(delayed jobs: hold 5 phút, booking 15 phút)" vertex="1">
          <mxGeometry height="100" width="200" x="1275" y="710" as="geometry" />
        </mxCell>
        <mxCell id="b-broker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Message Broker (chưa chọn cụ thể)&lt;/b&gt; — versioned events, at-least-once, dedup theo eventId, retry + backoff/jitter, poison message → DLQ. Producer ghi state + outbox atomic; consumer dùng inbox/idempotency (ARCH-008/010, EVT-COM)." vertex="1">
          <mxGeometry height="80" width="1420" x="100" y="880" as="geometry" />
        </mxCell>
        <mxCell id="b-rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" value="&lt;b&gt;Ràng buộc cứng:&lt;/b&gt; cấm shared database/schema/credential (ARCH-011) • cấm cross-service FK / ORM relation / SQL join (ARCH-012) • cấm giữ DB transaction qua network call và distributed transaction chưa duyệt (ARCH-014) • không tin actor header do client gửi (ARCH-015) • không lưu/log plaintext password/token/secret (ARCH-016) • cross-service chỉ dùng opaque ID, minimal snapshot, API hoặc event (ARCH-009) • mỗi service tự build/test/migrate/deploy (ARCH-023) • cấm synchronize:true." vertex="1">
          <mxGeometry height="100" width="1420" x="100" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="b-e1" edge="1" parent="1" source="b-guest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" target="b-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e2" edge="1" parent="1" source="b-admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" target="b-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e3" edge="1" parent="1" source="b-staff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" target="b-gateway" value="HTTPS /api/v1 (Bearer JWT)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e4" edge="1" parent="1" source="b-gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" target="b-identity" value="sync HTTP, versioned API port, timeout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e5" edge="1" parent="1" source="b-gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" target="b-catalog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e6" edge="1" parent="1" source="b-gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" target="b-booking">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e7" edge="1" parent="1" source="b-identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" target="b-iddb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e8" edge="1" parent="1" source="b-catalog" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" target="b-catdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e9" edge="1" parent="1" source="b-booking" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" target="b-bkgdb" value="migration riêng, own credential">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e10" edge="1" parent="1" source="b-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" target="b-redis" value="delayed jobs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e11" edge="1" parent="1" source="b-booking" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;exitX=1;exitY=0.25;entryX=0.5;entryY=1;" target="b-payos" value="tạo payment link (outbound, timeout)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e12" edge="1" parent="1" source="b-payos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="b-gateway" value="webhook POST /api/v1/webhooks/payments/payos — verify chữ ký raw body + timestamp">
          <mxGeometry relative="1" x="0.6585" y="20" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b-e13" edge="1" parent="1" source="b-catalog" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;exitX=0.25;exitY=1;" target="b-broker" value="publish (outbox): catalog.showtime.published.v1 / cancelled.v1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e14" edge="1" parent="1" source="b-broker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;exitY=0;entryX=0.42;entryY=1;dashed=1;" target="b-booking" value="consume + inbox dedup → snapshot ghế">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e15" edge="1" parent="1" source="b-booking" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;exitX=0.75;exitY=1;" target="b-broker" value="publish (outbox): booking.confirmed.v1 • payment.succeeded.v1 • booking.hold.expired.v1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e16" edge="1" parent="1" source="b-broker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;entryX=0.5;entryY=1;dashed=1;" target="b-worker" value="consume at-least-once">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e17" edge="1" parent="1" source="b-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="b-booking" value="gọi expiry/relay port qua contract (không chạm DB)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e18" edge="1" parent="1" source="b-operator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;dashed=1;entryX=0.5;entryY=0;" target="b-worker" value="health / metrics / DLQ / reconciliation (least privilege)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-erd" name="3. ERD — 3 database">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c-title" value="ERD theo service — FK chỉ tồn tại TRONG một database; tham chiếu xuyên service là opaque UUID + snapshot" style="text;html=1;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c-iddb" value="identity_db — Identity Service" style="swimlane;html=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="400" height="540" as="geometry" />
        </mxCell>
        <mxCell id="c-users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;email «UQ»&lt;br&gt;password_hash (bcrypt)&lt;br&gt;full_name&lt;br&gt;role_id → roles «FK»&lt;br&gt;is_active&lt;br&gt;created_at / updated_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c-iddb">
          <mxGeometry x="20" y="45" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c-roles" value="&lt;b&gt;roles&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;name «UQ» (CUSTOMER | STAFF | ADMIN)&lt;br&gt;description — seed khi init, không tạo qua API" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c-iddb">
          <mxGeometry x="20" y="235" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c-rtokens" value="&lt;b&gt;refresh_tokens&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;user_id → users «FK, CASCADE»&lt;br&gt;token_hash (SHA-256, không lưu token gốc)&lt;br&gt;is_revoked&lt;br&gt;expires_at&lt;br&gt;replaced_by_id → refresh_tokens (rotation chain, reuse detection)&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c-iddb">
          <mxGeometry x="20" y="365" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c-catdb" value="catalog_db — Catalog Service (PostgreSQL + pgvector cho AI stretch)" style="swimlane;html=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="800" height="1090" as="geometry" />
        </mxCell>
        <mxCell id="c-movies" value="&lt;b&gt;movies&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;title / original_title&lt;br&gt;genre (VARCHAR — MVP)&lt;br&gt;duration_minutes (0–600)&lt;br&gt;age_rating, release_date&lt;br&gt;status (DRAFT | COMING_SOON | NOW_SHOWING | ENDED | ARCHIVED)&lt;br&gt;mood_tags (AI search)&lt;br&gt;poster_url, synopsis, cast, language" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c-catdb">
          <mxGeometry x="20" y="40" width="360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c-cinemas" value="&lt;b&gt;cinemas&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;name, address&lt;br&gt;city «UQ(name, city)»&lt;br&gt;phone&lt;br&gt;is_active" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c-catdb">
          <mxGeometry x="20" y="260" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c-screens" value="&lt;b&gt;screens&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;cinema_id → cinemas «FK, CASCADE»&lt;br&gt;name «UQ(cinema_id, name)»&lt;br&gt;capacity (&gt; 0)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c-catdb">
          <mxGeometry x="20" y="420" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c-seats" value="&lt;b&gt;seats&lt;/b&gt; (master data — ghế vật lý)&lt;hr&gt;id : UUID «PK»&lt;br&gt;screen_id → screens «FK, CASCADE»&lt;br&gt;row / number «UQ(screen_id, row, number)»&lt;br&gt;seat_type (STANDARD | VIP | COUPLE — MVP chỉ STANDARD)&lt;br&gt;→ snapshot sang booking_db.showtime_seats khi tạo suất chiếu" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c-catdb">
          <mxGeometry x="20" y="560" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c-showtimes" value="&lt;b&gt;showtimes&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;movie_id → movies «FK, RESTRICT»&lt;br&gt;screen_id → screens «FK, RESTRICT»&lt;br&gt;start_time / end_time (CHECK end &gt; start)&lt;br&gt;base_price (INTEGER VND — không float)&lt;br&gt;status (SCHEDULED | CANCELLED)&lt;br&gt;Không overlap trong cùng screen (app-level)&lt;br&gt;Publish event sau commit" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c-catdb">
          <mxGeometry x="20" y="720" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c-trailers" value="&lt;b&gt;movie_trailers&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;movie_id → movies «FK, UQ» (1 phim 1 trailer)&lt;br&gt;url&lt;br&gt;status (DRAFT | PUBLISHED | UNPUBLISHED)&lt;br&gt;published_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c-catdb">
          <mxGeometry x="410" y="40" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-embed" value="&lt;b&gt;movie_embedding_documents&lt;/b&gt; (AI stretch)&lt;hr&gt;id : UUID «PK»&lt;br&gt;movie_id → movies «FK, CASCADE»&lt;br&gt;document_type (MOVIE_PROFILE | TRAILER_METADATA | REVIEW_SUMMARY)&lt;br&gt;content + content_hash (SHA-256, skip rebuild)&lt;br&gt;embedding : vector(1536) — pgvector&lt;br&gt;provider / model / dimensions&lt;br&gt;status (PENDING | READY | FAILED)&lt;br&gt;HNSW index chỉ khi data lớn" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="c-catdb">
          <mxGeometry x="410" y="190" width="370" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c-drafts" value="&lt;b&gt;movie_ai_content_drafts&lt;/b&gt; (AI stretch)&lt;hr&gt;id : UUID «PK»&lt;br&gt;movie_id → movies «FK, CASCADE»&lt;br&gt;draft_type (SYNOPSIS | TRAILER_DESCRIPTION | TAGS | FULL_CONTENT)&lt;br&gt;content : JSONB&lt;br&gt;status (DRAFT | APPLIED | REJECTED)&lt;br&gt;applied_by / rejected_by (opaque → users)&lt;br&gt;ai_request_log_id → ai_request_logs «FK»&lt;br&gt;Human-in-the-loop: chỉ Admin apply, không auto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="c-catdb">
          <mxGeometry x="410" y="400" width="370" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c-ailogs" value="&lt;b&gt;ai_request_logs&lt;/b&gt; (append-only)&lt;hr&gt;id : UUID «PK»&lt;br&gt;provider / model (openai, mock / gpt-4o-mini)&lt;br&gt;request_type (CONTENT_DRAFT | EMBEDDING | SEARCH)&lt;br&gt;prompt / response (truncated, sanitized, no PII)&lt;br&gt;tokens_input / tokens_output / latency_ms&lt;br&gt;status (SUCCESS | FAILED | TIMEOUT)&lt;br&gt;movie_id?, user_id? (opaque), request_id" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="c-catdb">
          <mxGeometry x="410" y="610" width="370" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c-prefs" value="&lt;b&gt;user_movie_preferences&lt;/b&gt; (AI stretch)&lt;hr&gt;id : UUID «PK»&lt;br&gt;user_id «UQ» (opaque → identity users)&lt;br&gt;preferred_genres / preferred_moods / disliked_genres" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="c-catdb">
          <mxGeometry x="410" y="800" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c-fdbk" value="&lt;b&gt;ai_recommendation_feedback&lt;/b&gt; (append-only, stretch)&lt;hr&gt;id : UUID «PK»&lt;br&gt;user_id (opaque), movie_id → movies «FK»&lt;br&gt;feedback_type (LIKED | DISLIKED | IRRELEVANT)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="c-catdb">
          <mxGeometry x="410" y="940" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c-bkgdb" value="booking_db — Booking Service (ACID, chống bán trùng ghế)" style="swimlane;html=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1320" y="40" width="440" height="1250" as="geometry" />
        </mxCell>
        <mxCell id="c-stseats" value="&lt;b&gt;showtime_seats&lt;/b&gt; — inventory, bảng bị lock nhiều nhất&lt;hr&gt;id : UUID «PK»&lt;br&gt;showtime_id (opaque → catalog.showtimes) «UQ(showtime, seat)»&lt;br&gt;seat_id (opaque → catalog.seats)&lt;br&gt;row / number / seat_type (snapshot copy từ seats)&lt;br&gt;price (snapshot từ base_price, override được)&lt;br&gt;status (AVAILABLE | HELD | SOLD | BLOCKED)&lt;br&gt;held_by_user_id (opaque → users), held_until&lt;br&gt;Hold ghế bắt buộc SELECT … FOR UPDATE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c-bkgdb">
          <mxGeometry x="20" y="40" width="400" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c-holds" value="&lt;b&gt;seat_holds&lt;/b&gt; (1 hold = nhóm ghế qua held_by_user_id)&lt;hr&gt;id : UUID «PK»&lt;br&gt;user_id (opaque → users)&lt;br&gt;showtime_id (opaque → showtimes)&lt;br&gt;status (ACTIVE | EXPIRED | CANCELLED | CONVERTED_TO_BOOKING)&lt;br&gt;expires_at = now + 5 phút; partial index WHERE ACTIVE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c-bkgdb">
          <mxGeometry x="20" y="270" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-bookings" value="&lt;b&gt;bookings&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;user_id (opaque → users)&lt;br&gt;showtime_id (opaque → showtimes)&lt;br&gt;seat_hold_id → seat_holds «FK, SET NULL»&lt;br&gt;total_amount (server tính — không trust client)&lt;br&gt;status (PENDING_PAYMENT | CONFIRMED | CANCELLED | EXPIRED)&lt;br&gt;expires_at = now + 15 phút&lt;br&gt;confirmed_at / cancelled_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c-bkgdb">
          <mxGeometry x="20" y="440" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c-bseats" value="&lt;b&gt;booking_seats&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;booking_id → bookings «FK»&lt;br&gt;showtime_seat_id → showtime_seats «FK»&lt;br&gt;price (snapshot giá lúc booking)&lt;br&gt;«UQ(booking_id, showtime_seat_id)»&lt;br&gt;«UQ(showtime_seat_id) khi CONFIRMED» — chốt DB cuối chống double-booking" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c-bkgdb">
          <mxGeometry x="20" y="650" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c-payments" value="&lt;b&gt;payments&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;booking_id → bookings «FK, UQ» (1 booking 1 payment)&lt;br&gt;amount (server tính = SUM booking_seats.price)&lt;br&gt;status (PENDING | PAID | FAILED | CANCELLED | EXPIRED)&lt;br&gt;order_code : BIGINT «UQ» (payOS)&lt;br&gt;payment_link_id / checkout_url&lt;br&gt;provider = PAYOS; paid_at / expired_at&lt;br&gt;Webhook: FOR UPDATE + idempotent (PAID → skip replay)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c-bkgdb">
          <mxGeometry x="20" y="830" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c-tickets" value="&lt;b&gt;tickets&lt;/b&gt;&lt;hr&gt;id : UUID «PK»&lt;br&gt;booking_id → bookings «FK»&lt;br&gt;booking_seat_id → booking_seats «FK, UQ» (1 ghế = tối đa 1 vé)&lt;br&gt;ticket_code «UQ» (vd TKT-A1B2C3D4 — QR/tra cứu)&lt;br&gt;status (ACTIVE | CHECKED_IN | CANCELLED)&lt;br&gt;checked_in_at, checked_in_by (opaque → staff user)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c-bkgdb">
          <mxGeometry x="20" y="1050" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c-logsdb" value="Operations logs (per-service, append-only)" style="swimlane;html=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="400" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c-audit" value="&lt;b&gt;audit_logs&lt;/b&gt; (chỉ INSERT — fail không block main op)&lt;hr&gt;id : UUID «PK»&lt;br&gt;actor_id (opaque, null = system job)&lt;br&gt;actor_role (role tại thời điểm thực hiện)&lt;br&gt;action (CREATE_MOVIE, HOLD_SEAT, CONFIRM_PAYMENT…)&lt;br&gt;resource_type / resource_id&lt;br&gt;details : JSONB (không password/token/card)&lt;br&gt;ip_address, request_id (correlation)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="c-logsdb">
          <mxGeometry x="20" y="40" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c-intlogs" value="&lt;b&gt;integration_logs&lt;/b&gt; (append-only operational metadata)&lt;hr&gt;id : UUID «PK»&lt;br&gt;provider / operation / outcome&lt;br&gt;response_status, latency_ms, error_code&lt;br&gt;request_id (correlation)&lt;br&gt;Allowlist + bounded retention; cấm raw body, token, signature, secret, PII và internal URL." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="c-logsdb">
          <mxGeometry x="20" y="240" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c-note" value="&lt;b&gt;Quy tắc cross-service (ARCH-009/012):&lt;/b&gt; đường nét đứt xám = opaque UUID + snapshot, KHÔNG có FK vật lý, KHÔNG JOIN xuyên database. Gồm: booking_db → catalog_db (showtime_id, seat_id), booking_db → identity_db (user_id, held_by_user_id, checked_in_by), catalog_db → identity_db (applied_by, user_id…). Lưu ý: docs/database 02–07 vẽ như một logical model duy nhất — khi tách DB các FK xuyên boundary phải chuyển thành opaque ID (ghi chú P1 trong tài liệu)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="400" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c-e1" value="1 — N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="c-roles" target="c-users">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c-e2" value="1 — N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="c-users" target="c-rtokens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c-e3" value="1 — 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="c-movies" target="c-trailers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c-e4" value="1 — N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c-movies" target="c-showtimes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c-e5" value="1 — N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="c-cinemas" target="c-screens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c-e6" value="1 — N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="c-screens" target="c-seats">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c-e7" value="1 — N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;exitX=1;exitY=0.75;entryX=1;entryY=0.25;" edge="1" parent="1" source="c-screens" target="c-showtimes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c-e8" value="1 — N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c-movies" target="c-embed">
